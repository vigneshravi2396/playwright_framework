            def getSuitePathMap() {
                def mapFile = env.SUITE_PATH_MAP_FILE ?: '.pipeline-suite-path-map.json'
                if (!fileExists(mapFile)) {
                    writeExecutionResult('FAILED', 'Validate Suite', 'UNEXPECTED_ERROR', 'Suite path map not initialized — discovery must run before suite validation or execution')
                    error('Suite path map not initialized — discovery must run before suite validation or execution')
                }
                return readJSON(file: mapFile)
