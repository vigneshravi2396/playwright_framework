            // Shared: locate package.json used for Playwright version logging (all request types)
            def locatePackageJsonForPlaywrightVersion() {
                // Prefer customer clone when it declares @playwright/test (RECORDED/UPLOADED before/while client-tests exists)
                if (fileExists('client-tests/package.json')) {
                    try {
                        def clientPkg = readJSON(file: 'client-tests/package.json')
                        if (clientPkg?.devDependencies?.get('@playwright/test')?.toString()?.trim()) {
                            echo '📄 Using client-tests/package.json for Playwright version'
                            return 'client-tests/package.json'
                        }
                    } catch (Exception ignored) {
                        // fall through to workspace root
                    }
                }
                if (fileExists('package.json')) {
                    echo '📄 Using ./package.json for Playwright version'
                    return 'package.json'
                }
                return null
            }

            // Shared: normalize @playwright/test from package.json (logging / debug only)
            def extractPlaywrightVersionFromPackageJson(String packageJsonPath = null) {
                def path = packageJsonPath ?: locatePackageJsonForPlaywrightVersion()
                if (!path) {
                    echo '⚠️ package.json not found — cannot log Playwright version'
                    return null
                }
                def pkg = readJSON(file: path)
                def raw = pkg?.devDependencies?.get('@playwright/test')
                if (!raw?.toString()?.trim()) {
                    echo "⚠️ devDependencies[\"@playwright/test\"] missing in ${path}"
                    return null
                }
                def text = raw.toString().trim()
                def normalized = text.replaceAll(/^[\^~>=<\s=]+/, '').trim()
                def matcher = (normalized =~ /(\d+\.\d+\.\d+)/)
                if (!matcher.find()) {
                    echo "⚠️ Unable to parse Playwright version from '${text}' in ${path}"
                    return null
                }
                def version = matcher.group(1)
                echo "📦 @playwright/test raw='${text}' → normalized='${version}' (from ${path})"
                return version
            }

