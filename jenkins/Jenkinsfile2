            // Force-delete root-owned artifacts, then restore workspace ownership to Jenkins user
            def prepareWorkspaceForCheckout() {
                sh '''
                    set +e
                    echo '🧹 Preparing workspace for checkout...'
                    HOST_UID=$(id -u)
                    HOST_GID=$(id -g)
                    echo "   Restoring ownership to ${HOST_UID}:${HOST_GID}"

                    if command -v docker >/dev/null 2>&1; then
                        docker run --rm \
                            -v "$(pwd):/ws" \
                            -w /ws \
                            --user root \
                            alpine:3.19 \
                            sh -c "
                                set +e
                                # Restore ownership first so Jenkins/Git can always write
                                chown -R ${HOST_UID}:${HOST_GID} /ws
                                chmod -R u+rwX /ws
                                rm -rf /ws/node_modules /ws/test-results /ws/reports /ws/playwright-report /ws/blob-report /ws/client-tests /ws/tests /ws/.npm-install-hash
                                rm -f /ws/clone_out.txt /ws/.dec-in-* /ws/.dec-out-*
                                find /ws -maxdepth 1 -name '*.zip' -exec rm -f {} +
                                chown -R ${HOST_UID}:${HOST_GID} /ws
                                chmod -R u+rwX /ws
                            " 2>/dev/null || \
                        docker run --rm \
                            -v "$(pwd):/ws" \
                            -w /ws \
                            --user root \
                            alpine:3.19 \
                            sh -c "
                                set +e
                                chown -R ${HOST_UID}:${HOST_GID} /ws
                                chmod -R u+rwX /ws
                                rm -rf /ws/node_modules /ws/test-results /ws/reports /ws/playwright-report /ws/blob-report /ws/client-tests /ws/tests /ws/.npm-install-hash
                                rm -f /ws/clone_out.txt /ws/.dec-in-* /ws/.dec-out-*
                                find /ws -maxdepth 1 -name '*.zip' -exec rm -f {} +
                                chown -R ${HOST_UID}:${HOST_GID} /ws
                                chmod -R u+rwX /ws
                            " 2>/dev/null || true
                    fi

                    chmod -R u+w . 2>/dev/null || true
                    rm -rf node_modules test-results reports playwright-report blob-report client-tests tests .npm-install-hash 2>/dev/null || true
                    rm -f clone_out.txt .dec-in-* .dec-out-* 2>/dev/null || true
                    find . -maxdepth 1 -name '*.zip' -exec rm -f {} + 2>/dev/null || true
                    echo '✅ Workspace cleaned and ownership restored'
