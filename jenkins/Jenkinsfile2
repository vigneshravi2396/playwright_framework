            // Recursively scan tests/ once and map suite folder name → actual directory path
            def discoverSuitePaths() {
                echo '🔍 Discovering suite directories under tests/...'
                def output = sh(
                    script: '''
                        set -e
                        find tests -type d ! -path tests ! -path '*/.*' 2>/dev/null | while IFS= read -r dir; do
                            name=$(basename "$dir")
                            printf '%s|%s\n' "$name" "$dir"
                        done
                    ''',
                    returnStdout: true
                ).trim()

                def map = [:]
                if (output) {
                    output.split('\n').each { line ->
                        if (!line?.trim()) {
                            return
                        }
                        def separator = line.indexOf('|')
                        if (separator < 0) {
                            return
                        }
                        def name = line.substring(0, separator)
                        def path = line.substring(separator + 1)
                        if (map.containsKey(name)) {
                            def existing = map[name]
                            if (existing instanceof List) {
                                existing.add(path)
                            } else {
                                map[name] = [existing, path]
                            }
                        } else {
                            map[name] = path
                        }
                    }
                }

                echo "✅ Discovered ${map.size()} suite name(s): ${map.keySet().join(', ')}"
                map.each { name, path ->
                    def display = path instanceof List ? path.join(', ') : path
                    echo "   ${name} → ${display}"
                }
                return map
            }

            def cacheSuitePathMap(Map suitePathMap) {
                // writeJSON is Pipeline-approved; avoid groovy.json.JsonOutput (Script Security)
