            // Shared: launch-based browser usability check (not a directory existence check)
            def arePlaywrightBrowsersUsable() {
                def browserParam = toPlainString(params.browser)
                def engine = [
                    chrome  : 'chromium',
                    chromium: 'chromium',
                    firefox : 'firefox',
                    webkit  : 'webkit'
                ].get(browserParam, 'chromium')

                echo "🔍 Validating Playwright browser usability (engine=${engine}, browser=${browserParam})..."
                def status = sh(
                    returnStatus: true,
                    script: """
                        set +e
                        export PLAYWRIGHT_BROWSERS_PATH="\${PLAYWRIGHT_BROWSERS_PATH:-/ms-playwright}"
                        node -e '
                          const engine = "${engine}";
                          let pw;
                          try { pw = require("playwright"); }
                          catch (e1) {
                            try { pw = require("@playwright/test"); }
                            catch (e2) { console.error(e2); process.exit(1); }
                          }
                          const launcher = pw[engine];
                          if (!launcher || typeof launcher.launch !== "function") {
                            console.error("No launcher for engine:", engine);
                            process.exit(1);
                          }
                          launcher.launch({ headless: true })
                            .then((browser) => browser.close())
                            .then(() => { console.log("Playwright browser launch OK:", engine); process.exit(0); })
                            .catch((err) => { console.error(err); process.exit(1); });
                        '
                    """
                )
                return status == 0
            }

