            pipeline {
                agent none

                parameters {
                    string(
                        name: 'client_repo_url',
                        defaultValue: 'https://github.com/qadence-ai/boilerplate-qa.git',
                        description: 'Client tests repository URL (e.g. https://github.com/company/client-tests.git)'
                    )
                    string(
                        name: 'client_branch',
                        defaultValue: 'vignesh_test_poc_new',
                        description: 'Branch to checkout from the client tests repository'
                    )
                    string(
                        name: 'client_username',
                        defaultValue: 'qadence-ideas2it',
                        description: 'Username for client repository checkout'
                    )
                    string(
                        name: 'client_pat',
                        defaultValue: '',
                        description: 'AES-256-CBC encrypted GitHub PAT for client repository checkout'
                    )
                    string(
                        name: 'aws_access_key_id',
                        defaultValue: '',
                        description: 'AES-256-CBC encrypted AWS access key ID for S3 upload'
                    )
                    string(
                        name: 'aws_secret_access_key',
                        defaultValue: '',
                        description: 'AES-256-CBC encrypted AWS secret access key for S3 upload'
                    )
                    // New Requirement: suite_testcase JSON mapping suites to test files
                    text(
                        name: 'suite_testcase',
                        defaultValue: '',
                        description: 'JSON map of suite names to testcase files (use "all" for full suite)'
                    )
                    choice(
                        name: 'browser',
                        choices: ['chrome', 'firefox', 'webkit', 'chromium'],
                        description: 'Browser to run tests on'
                    )
                    choice(
                        name: 'environment',
                        choices: ['dev', 'staging', 'example'],
                        description: 'Target environment for secrets'
                    )
                    string(
                        name: 's3_prefix',
                        defaultValue: '/testing/results/upload/2026-06-17_07-43-21/staging',
                        description: 'Folder path inside the S3 bucket'
                    )
                    string(
                        name: 'aws_region',
                        defaultValue: 'us-east-1',
                        description: 'AWS region for S3 upload'
                    )
                    string(name: 'test_run_id', defaultValue: '', description: 'Run ID for this execution')
                    string(name: 'tenantId', defaultValue: '', description: 'Tenant ID for this execution')
                    string(name: 'applicationId', defaultValue: '', description: 'App ID for this execution')
                    string(name: 'test_execution_id', defaultValue: '', description: 'Test Execution ID')
                    string(name: 'test_execution_request_id', defaultValue: '', description: 'Test Execution Request ID')
                    string(
                        name: 'testCaseRequestType',
                        defaultValue: '',
                        description: 'Type of testcase request. Allowed values: RECORDED_OR_UPLOADED or IMPORTED'
                    )
                    string(
                        name: 'workers',
                        defaultValue: '4',
                        description: 'Number of parallel workers'
                    )
                }

                environment {
                    CI = 'true'
                    METADATA_FILE = 'metadata.json'
                    BUILD_UNIQUE_ID = "build-${BUILD_NUMBER}-${BUILD_ID}"
                    BROWSER_CACHE_FILE = '/tmp/.playwright-browsers-verified'
                    NPM_HASH_FILE = '.npm-install-hash'
                    // Single configurable Docker image for IMPORT / RECORDER / UPLOAD
                    DOCKER_AGENT_IMAGE = 'playwright-taas:latest'
                    DOCKER_AGENT_ARGS = '--shm-size=2gb -u root'
                }

                options {
                    buildDiscarder(logRotator(numToKeepStr: '15', artifactNumToKeepStr: '10'))
                    timestamps()
                    timeout(time: 2, unit: 'HOURS')
                    skipDefaultCheckout(true)
                }

                stages {
                    // Host: checkout (+ IMPORT: framework → ensure image → customer) + log Playwright version
                    stage('Prepare Checkout and Docker Image') {
                        agent { label 'built-in' }
                        steps {
                            script {
                                try {
                                    echo '🧹 Cleaning workspace before pipeline execution...'
                                    cleanWorkspace()
                                    echo '✅ Workspace prepared'

                                    if (isImportedRequest()) {
                                        // IMPORT replaces the workspace with the customer repo — build image first while jenkins/Dockerfile exists
                                        echo '🔄 IMPORT — checking out framework repository (Docker build context)...'
                                        prepareWorkspaceForCheckout()
                                        checkoutFrameworkRepository()
                                        echo '================ AFTER FRAMEWORK CHECKOUT ================'
                                        sh '''
                                            set +e
                                            echo "PWD:"
                                            pwd

                                            echo ""
                                            echo "Top level:"
                                            ls -lrta

                                            echo ""
                                            echo "Workspace tree (depth 3):"
                                            find . -maxdepth 3 | sort

                                            echo ""
                                            echo "Framework src:"
                                            ls -lrta src || true

                                            echo ""
                                            echo "Framework tests:"
                                            ls -lrta tests || true

                                            echo "========================================================="
                                        '''
                                        ensurePlaywrightDockerImagePulled(getDockerAgentImage())
                                        env.DOCKER_AGENT_ARGS = env.DOCKER_AGENT_ARGS ?: '--shm-size=2gb -u root'
                                        echo "🐳 Docker image ready: ${getDockerAgentImage()}"

                                        echo '🔄 IMPORT — checking out customer repository...'
                                        checkoutImportedCustomerRepository()
                                        echo '================ AFTER CUSTOMER CHECKOUT ================'
                                        sh '''
                                            set +e
                                            echo "PWD:"
                                            pwd

                                            echo ""
                                            echo "Top level:"
                                            ls -lrta

                                            echo ""
                                            echo "Workspace tree (depth 4):"
                                            find . -maxdepth 4 | sort

                                            echo ""
                                            echo "Root src:"
                                            ls -lrta src || true

                                            echo ""
                                            echo "Root tests:"
                                            ls -lrta tests || true

                                            echo ""
                                            echo "Customer repo:"
                                            ls -lrta client-tests || true

                                            echo "========================================================="
                                        '''
                                    } else {
                                        echo '🔄 Checking out repository...'
                                        checkoutRepository()
                                        ensurePlaywrightDockerImagePulled(getDockerAgentImage())
                                        env.DOCKER_AGENT_ARGS = env.DOCKER_AGENT_ARGS ?: '--shm-size=2gb -u root'
                                    }

                                    echo '✅ Checkout completed successfully'
                                    logWorkspaceAfterCheckout()
                                    logDetectedPlaywrightVersion()
                                    echo "🐳 Pipeline will run inside: ${getDockerAgentImage()}"
                                } catch (Exception e) {
                                    writeExecutionResult('FAILED', 'Prepare Checkout and Docker Image', 'UNEXPECTED_ERROR', "Prepare/checkout/image resolve failed: ${e.message}")
                                    error("❌ Prepare/checkout/image resolve failed: ${e.message}")
                                }
                            }
                        }
                    }

                    // Host agent + docker.inside(getDockerAgentImage())
                    stage('Run Pipeline') {
                        agent { label 'built-in' }
                        steps {
                            script {
                                def image = getDockerAgentImage()
                                def args = getPlaywrightDockerArgs()
                                echo "🐳 Entering Playwright container: ${image} (${args})"
                                docker.image(image).inside(args) {
                                    stage('Ensure CI Tools') {
                                        ensureCiToolsInContainer()
                                    }

                                    stage('Debug Workspace') {
                                        echo '🔍 Inspecting workspace structure...'
                                        sh '''
                                            pwd
                                            ls -la
                                            find . -maxdepth 3
                                        '''
                                        echo '⏳ Waiting 2 seconds...'
                                        sleep(time: 2, unit: 'SECONDS')
                                    }

                                    stage('Validate Suite') {
                                        def suiteTestcase = parseSuiteTestcase()
                                        cacheSuitePathMap(discoverSuitePaths())
                                        validateSuiteTestcase(suiteTestcase)
                                    }

                                    stage('Setup') {
                                        withEnv(['PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin']) {
                                            def filteredSuites = readPipelineJsonMap(
                                                env.FILTERED_SUITE_TESTCASE_FILE ?: '.pipeline-filtered-suite-testcase.json'
                                            )
                                            if (!filteredSuites) {
                                                env.SKIP_PLAYWRIGHT = 'true'
                                                echo '⏭️ Skipping Setup — no valid suites after suite validation'
                                            } else {
                                                try {
                                                    echo '📦 Installing dependencies...'
                                                    if (isImportedRequest()) {
                                                        installImportedDependencies()
                                                        ensureImportedPlaywrightChromeInstalled()
                                                    } else {
                                                        installDependenciesOptimized()
                                                        ensurePlaywrightBrowsersInstalled()
                                                    }
                                                    echo '✅ Setup completed successfully'
                                                } catch (Exception e) {
                                                    writeExecutionResult('FAILED', 'Setup', 'SETUP_FAILED', "Setup failed: ${e.message}")
                                                    error("❌ Setup failed: ${e.message}")
                                                }
                                            }
                                        }
                                    }

                                    stage('Validate Testcases') {
                                        if (env.SKIP_PLAYWRIGHT == 'true') {
                                            echo '⏭️ Skipping Validate Testcases — no valid suites'
                                        } else {
                                            // Shared Recorder/Upload/IMPORT validation (titles via --list, files via find)
                                            validateTestcaseFiles(parseSuiteTestcase())
                                        }
                                    }

                                    stage('Create Metadata') {
                                        try {
                                            createMetadata()
                                        } catch (Exception e) {
                                            writeExecutionResult('FAILED', 'Create Metadata', 'METADATA_FAILED', "Metadata creation failed: ${e.message}")
                                            error("❌ Metadata creation failed: ${e.message}")
                                        }
                                    }

                                    stage('Execute Tests') {
                                        try {
                                            timeout(time: 100, unit: 'MINUTES') {
                                                if (env.SKIP_PLAYWRIGHT == 'true') {
                                                    finalizeValidationOnlyRun()
                                                } else if (isImportedRequest()) {
                                                    runImportedSuiteTestcases()
                                                } else {
                                                    runSuiteTestcases()
                                                }
                                            }
                                        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
                                            echo '⏱️ Test execution timed out'
                                            writeExecutionResult('FAILED', 'Execute Tests', 'TIMEOUT', 'Test execution timed out')
                                            currentBuild.result = 'UNSTABLE'
                                        } catch (Exception e) {
                                            echo "⚠️ Test execution encountered errors: ${e.message}"
                                            writeExecutionResult('FAILED', 'Execute Tests', 'UNEXPECTED_ERROR', "Test execution encountered errors: ${e.message}")
                                            currentBuild.result = 'UNSTABLE'
                                        }
                                    }

                                    stage('Upload to S3') {
                                        try {
                                            uploadAllPendingZips()
                                        } catch (Exception e) {
                                            writeExecutionResult('FAILED', 'Upload to S3', 'UPLOAD_FAILED', "S3 upload failed: ${e.message}")
                                            currentBuild.result = 'FAILURE'
                                            error("S3 upload failed: ${e.message}")
                                        }
                                    }

                                    stage('Archive Artifacts') {
                                        try {
                                            echo '📦 Archiving artifacts...'
                                            archiveArtifacts(
                                                artifacts: '**/*.zip,metadata.json,test_status*.json,test_summary.json',
                                                allowEmptyArchive: true,
                                                fingerprint: false,
                                                onlyIfSuccessful: false
                                            )
                                        } catch (Exception e) {
                                            echo "⚠️ Artifact archiving failed: ${e.message}"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                post {
                    always {
                        script {
                            printSummary()
                            try {
                                node('built-in') {
                                    def hasExecutionResult = false
                                    if (fileExists(env.METADATA_FILE)) {
                                        try {
                                            def meta = readJSON(file: env.METADATA_FILE)
                                            hasExecutionResult = (meta?.executionResult != null)
                                        } catch (Exception ignored) {
                                            hasExecutionResult = false
                                        }
                                    }
                                    if (!hasExecutionResult) {
                                        def buildStatus = currentBuild.result ?: 'SUCCESS'
                                        if (buildStatus == 'SUCCESS') {
                                            writeExecutionResult('SUCCESS', 'Completed', '', 'Execution completed successfully')
                                        } else {
                                            writeExecutionResult('FAILED', 'Completed', 'UNEXPECTED_ERROR', "Pipeline ended with status ${buildStatus}")
                                        }
                                    }
                                    archiveArtifacts(
                                        artifacts: 'metadata.json',
                                        allowEmptyArchive: true,
                                        fingerprint: false,
                                        onlyIfSuccessful: false
                                    )
                                }
                            } catch (Exception e) {
                                echo "⚠️ Failed to archive metadata.json: ${e.message}"
                            }
                            try {
                                // cleanWorkspace() — temporarily disabled for debugging
                                // node('built-in') {
                                //     echo '🧹 Cleaning workspace after pipeline execution...'
                                //     cleanWorkspace()
                                //     echo '✅ Workspace cleaned'
                                // }
                                echo '⚠️ Workspace cleanup skipped for debugging.'
                            } catch (Exception e) {
                                echo "⚠️ Final workspace cleanup failed: ${e.message}"
                            }
                        }
                    }

                    success {
                        echo '✅ Pipeline completed successfully!'
                    }

                    unstable {
                        echo '⚠️ Pipeline unstable - Some tests failed or upload issues occurred'
                    }

                    failure {
                        script {
                            echo '❌ Pipeline failed - Check logs for details'
                            try {
                                node('built-in') {
                                    uploadFailureArtifactsIfNeeded()
                                }
                            } catch (Exception e) {
                                echo "⚠️ Failure artifact upload failed: ${e.message}"
                            }
                        }
                    }

                    aborted {
                        echo '🛑 Pipeline aborted by user'
                    }
                }
            }

            // ============================================================================
            // OPTIMIZED UTILITY FUNCTIONS - ALL FIXED
            // ============================================================================

            // Force Jenkins env / GString / wrappers into a plain java.lang.String
            def toPlainString(def value) {
                if (value == null) {
                    return ''
                }
                return value.toString()
            }

            // Recursively convert maps/lists to plain JSON-safe Java types for writeJSON
            // (avoids GString / JSONObject / JSONArray / EnvVars wrapper serialization)
            def toPlainJsonValue(def value) {
                if (value == null) {
                    return null
                }
                if (value instanceof Boolean) {
                    return value
                }
                if (value instanceof Number) {
                    return value
                }
                if (value instanceof CharSequence) {
                    return value.toString()
                }
                if (value instanceof Map) {
                    def out = [:]
                    value.each { k, v ->
                        out[k.toString()] = toPlainJsonValue(v)
                    }
                    return out
                }
                if (value instanceof Collection) {
                    def out = []
                    value.each { item ->
                        out.add(toPlainJsonValue(item))
                    }
                    return out
                }
                // Unknown Jenkins wrappers → plain string
                return value.toString()
            }

            // Structured execution result stored inside metadata.json → executionResult
            def writeExecutionResult(String status, String stage, String errorCode, String message) {
                if (fileExists(env.METADATA_FILE)) {
                    try {
                        def metadata = readJSON(file: env.METADATA_FILE)
                        def existing = metadata?.executionResult
                        def existingStatus = (existing?.status ?: '').toString()
                        def existingCode = (existing?.errorCode ?: '').toString()

                        // Once validation recorded PARTIAL_*, never overwrite (ZIP / Playwright / post hooks)
                        if (existingStatus == 'PARTIAL_SUCCESS' || existingStatus == 'PARTIAL_FAILED') {
                            echo "📝 executionResult already ${existingStatus} — preserving validation result (incoming status=${status}, errorCode=${errorCode ?: 'N/A'})"
                            return
                        }

                        // Playwright failure is primary — do not let ZIP packaging overwrite UNSTABLE/PLAYWRIGHT_FAILED
                        if (existingStatus == 'UNSTABLE' && existingCode == 'PLAYWRIGHT_FAILED' && errorCode == 'ZIP_CREATION_FAILED') {
                            echo 'executionResult already recorded (PLAYWRIGHT_FAILED) — keeping Playwright execution result over ZIP packaging failure'
                            return
                        }

                        if (status == 'FAILED') {
                            if (existingStatus == 'FAILED') {
                                def newIsGeneric = (errorCode == 'UNEXPECTED_ERROR')
                                def existingIsSpecific = existingCode && existingCode != 'UNEXPECTED_ERROR'
                                if (newIsGeneric && existingIsSpecific) {
                                    echo "📝 executionResult already recorded (${existingCode}) — keeping specific failure over UNEXPECTED_ERROR"
                                    return
                                }
                            }
                        }
                    } catch (Exception ignored) {
                        // proceed to write
                    }
                }

                def timestamp = sh(script: 'date -u +%Y-%m-%dT%H:%M:%SZ', returnStdout: true).trim()
                // Explicit plain strings — never store env.BUILD_* / GString directly
                def buildNumber = toPlainString(env.BUILD_NUMBER)
                def buildUrl = toPlainString(env.BUILD_URL)
                def result = [
                    status     : toPlainString(status),
                    stage      : toPlainString(stage),
                    message    : toPlainString(message),
                    timestamp  : toPlainString(timestamp),
                    buildNumber: buildNumber,
                    buildUrl   : buildUrl
                ]
                if (errorCode?.trim()) {
                    result.errorCode = toPlainString(errorCode)
                }

                syncExecutionResultToMetadata(toPlainJsonValue(result))
                echo "📝 metadata.json executionResult written: status=${status}, stage=${stage}, errorCode=${errorCode ?: 'N/A'}"
            }

            // Convert readJSON / net.sf.json.JSONArray to a plain Groovy ArrayList.
            // JSONArray.join(String) is blocked by Script Security; ArrayList.join is allowed.
            def toGroovyList(def value) {
                def result = []
                if (value == null) {
                    return result
                }
                value.each { item ->
                    result.add(item == null ? null : item.toString())
                }
                return result
            }

            // Track ZIP names for multi-upload (success + Failure_*.zip) without JsonOutput
            def addPendingUploadZip(String zipName) {
                def file = '.pipeline-upload-zips.json'
                def zips = []
                if (fileExists(file)) {
                    def existing = readJSON(file: file)
                    zips = toGroovyList(existing)
                }
                if (zipName?.trim() && !zips.contains(zipName)) {
                    zips.add(zipName)
                }
                writeJSON(file: file, json: zips)
                env.PENDING_UPLOAD_ZIPS_FILE = file
            }

            def uploadAllPendingZips() {
                def file = env.PENDING_UPLOAD_ZIPS_FILE ?: '.pipeline-upload-zips.json'
                def zips = []
                if (fileExists(file)) {
                    zips = toGroovyList(readJSON(file: file))
                }
                if (env.ZIP_NAME?.trim() && fileExists(env.ZIP_NAME) && !zips.contains(env.ZIP_NAME)) {
                    zips.add(0, env.ZIP_NAME)
                }
                if (!zips) {
                    uploadToS3Optimized(env.ZIP_NAME)
                    return
                }
                echo "📤 Uploading ${zips.size()} ZIP(s) to S3: ${zips.join(', ')}"
                zips.each { zipName ->
                    uploadToS3Optimized(zipName as String)
                }
            }

            // Lightweight Failure_<label>.zip (metadata + failure_info) — does NOT upload (Upload stage does)
            def packageValidationFailureZip(String label, Map failureInfo) {
                def safeLabel = label.toString().replaceAll(/[^A-Za-z0-9._-]/, '_')
                def zipName = "Failure_${safeLabel}.zip"
                def suiteDir = "Failure_${safeLabel}"
                ensureMinimalMetadata()
                writeJSON(file: '.pipeline-failure-info-tmp.json', json: toPlainJsonValue(failureInfo))
                sh """
                    set -e
                    echo "📦 Creating validation failure package: ${zipName}"
                    mkdir -p "${suiteDir}"
                    cp "${env.METADATA_FILE}" "${suiteDir}/" 2>/dev/null || true
                    cp .pipeline-failure-info-tmp.json "${suiteDir}/failure_info.json"
                    zip -r -q -6 "${zipName}" "${suiteDir}"
                    rm -rf "${suiteDir}"
                    ls -lh "${zipName}"
                """
                addPendingUploadZip(zipName)
                echo "✅ Failure ZIP ready: ${zipName}"
                return zipName
            }

            def readPipelineJsonList(String fileName) {
                if (!fileExists(fileName)) {
                    return []
                }
                return toGroovyList(readJSON(file: fileName))
            }

            def readPipelineJsonMap(String fileName) {
                if (!fileExists(fileName)) {
                    return [:]
                }
                def data = readJSON(file: fileName)
                if (!(data instanceof Map)) {
                    return [:]
                }
                // Copy to plain map; convert nested JSONArray/List values via toGroovyList
                def result = [:]
                data.each { key, value ->
                    if (value instanceof Collection) {
                        result[key.toString()] = toGroovyList(value)
                    } else {
                        result[key.toString()] = value
                    }
                }
                return result
            }

            // Write final executionResult once (SUCCESS / PARTIAL_FAILED / FAILED) + validation lists
            // Shared by Recorder/Upload and IMPORT — validation PARTIAL_FAILED takes precedence over PLAYWRIGHT_FAILED
            def writeFinalValidationExecutionResult(int playwrightExitCode, boolean didExecute) {
                def validSuites = readPipelineJsonList('.pipeline-valid-suites.json')
                def failedSuites = readPipelineJsonList('.pipeline-failed-suites.json')
                def validTestcases = readPipelineJsonList('.pipeline-executed-testcases.json')
                def missingTestcases = readPipelineJsonList('.pipeline-missing-testcases.json')

                def hasSuiteFailures = failedSuites && !failedSuites.isEmpty()
                def hasTestcaseFailures = missingTestcases && !missingTestcases.isEmpty()

                if (!didExecute) {
                    // Case 4: everything invalid
                    def errorCode = hasSuiteFailures ? 'SUITE_NOT_FOUND' : 'TESTCASE_NOT_FOUND'
                    def msg = hasSuiteFailures
                        ? "All requested suites were invalid: ${failedSuites.join(', ')}"
                        : "All requested testcases were invalid: ${missingTestcases.join(', ')}"
                    writeExecutionResult('FAILED', 'Completed', errorCode, msg)
                    mergeValidationListsIntoExecutionResult(validSuites, failedSuites, validTestcases, missingTestcases)
                    return
                }

                if (hasSuiteFailures || hasTestcaseFailures) {
                    // Case 1 / 2: PARTIAL_FAILED (validation gaps — not a Playwright runtime failure)
                    def errorCode = hasSuiteFailures ? 'PARTIAL_SUITE_NOT_FOUND' : 'PARTIAL_TESTCASE_NOT_FOUND'
                    def msgParts = []
                    if (hasSuiteFailures) {
                        msgParts.add("${validSuites.size()} suite(s) valid, ${failedSuites.size()} suite(s) not found")
                    }
                    if (hasTestcaseFailures) {
                        msgParts.add("${validTestcases.size()} testcase(s) executed, ${missingTestcases.size()} testcase(s) not found")
                    }
                    writeExecutionResult('PARTIAL_FAILED', 'Completed', errorCode, msgParts.join('. ') + '.')
                    mergeValidationListsIntoExecutionResult(validSuites, failedSuites, validTestcases, missingTestcases)
                    return
                }

                if (playwrightExitCode != 0) {
                    writeExecutionResult('UNSTABLE', 'Execute Tests', 'PLAYWRIGHT_FAILED', "Playwright tests failed with exit code: ${playwrightExitCode}")
                    return
                }

                // Case 3: everything valid
                writeExecutionResult('SUCCESS', 'Completed', '', 'Execution completed successfully')
            }

            def mergeValidationListsIntoExecutionResult(List validSuites, List failedSuites, List validTestcases, List missingTestcases) {
                if (!fileExists(env.METADATA_FILE)) {
                    return
                }
                def metadata = readJSON(file: env.METADATA_FILE)
                if (!(metadata.executionResult instanceof Map)) {
                    return
                }
                // Always store plain ArrayList<String> — never JSONArray / wrappers
                def plainValidSuites = toGroovyList(validSuites)
                def plainFailedSuites = toGroovyList(failedSuites)
                def plainValidTestcases = toGroovyList(validTestcases)
                def plainMissingTestcases = toGroovyList(missingTestcases)

                metadata.executionResult.validSuites = plainValidSuites
                metadata.executionResult.failedSuites = plainFailedSuites
                metadata.executionResult.validTestcases = plainValidTestcases
                metadata.executionResult.missingTestcases = plainMissingTestcases
                // Also expose on metadata root for consumers
                metadata.validSuites = plainValidSuites
                metadata.failedSuites = plainFailedSuites
                metadata.validTestcases = plainValidTestcases
                metadata.missingTestcases = plainMissingTestcases

                // Re-normalize entire metadata tree before writeJSON
                writeJSON(file: env.METADATA_FILE, json: toPlainJsonValue(metadata), pretty: 4)
                sh "cat ${env.METADATA_FILE} || true"
            }

            // Create ONE Failure_Validation.zip aggregating all invalid suites + missing testcases
            def packageAllValidationFailureZips() {
                def failedSuites = toGroovyList(readPipelineJsonList('.pipeline-failed-suites.json'))
                def missingBySuite = readPipelineJsonMap('.pipeline-missing-by-suite.json')
                def invalidTestcases = [:]
                missingBySuite.each { suite, missingList ->
                    invalidTestcases[suite.toString()] = toGroovyList(missingList)
                }

                def failureInfo = [
                    invalidSuites    : failedSuites,
                    invalidTestcases : invalidTestcases
                ]

                echo "📦 Packaging single Failure_Validation.zip (invalidSuites=${failedSuites.size()}, suitesWithMissingTestcases=${invalidTestcases.size()})"
                packageValidationFailureZip('Validation', failureInfo)
            }

            // Case 4 path: no Playwright — write FAILED, create one Failure_Validation.zip
            def finalizeValidationOnlyRun() {
                echo '❌ No valid suites/testcases to execute — packaging Failure_Validation.zip'
                writeFinalValidationExecutionResult(0, false)
                packageAllValidationFailureZips()
                env.ZIP_NAME = ''
                currentBuild.result = 'FAILURE'
            }

            // Merge/update only executionResult in metadata.json (create minimal metadata if missing)
            def syncExecutionResultToMetadata(def result) {
                def metadata
                if (fileExists(env.METADATA_FILE)) {
                    metadata = readJSON(file: env.METADATA_FILE)
                } else {
                    def timestamp = sh(script: 'date -u +%Y-%m-%dT%H:%M:%SZ', returnStdout: true).trim()
                    metadata = [
                        tenantId                  : toPlainString(params.tenantId ?: 'N/A'),
                        applicationId             : toPlainString(params.applicationId ?: 'N/A'),
                        test_run_id               : toPlainString(params.test_run_id ?: 'N/A'),
                        test_execution_id         : toPlainString(params.test_execution_id ?: 'N/A'),
                        test_execution_request_id : toPlainString(params.test_execution_request_id ?: 'N/A'),
                        testCaseRequestType       : toPlainString(params.testCaseRequestType ?: 'N/A'),
                        browser                   : toPlainString(params.browser),
                        environment               : toPlainString(params.environment),
                        buildNumber               : toPlainString(env.BUILD_NUMBER),
                        buildUrl                  : toPlainString(env.BUILD_URL),
                        timestamp                 : toPlainString(timestamp)
                    ]
                }
                metadata.executionResult = toPlainJsonValue(result)
