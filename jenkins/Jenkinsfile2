            // IMPORT flow: run customer project with BROWSER + ENV via cross-env (one Playwright run = one results/)
            // On Playwright failure: still collect reports → ZIP → Upload stage → UNSTABLE (same as Recorder/Upload)
            def runImportedSuiteTestcases() {
                echo '🧪 IMPORT Execute — customer Playwright project (direct backend suite/testcase)'
                def suiteTestcase = parseSuiteTestcase()
                def filteredFile = env.FILTERED_SUITE_TESTCASE_FILE ?: '.pipeline-filtered-suite-testcase.json'
                if (fileExists(filteredFile)) {
                    def filtered = readJSON(file: filteredFile)
                    if (filtered instanceof Map && !filtered.isEmpty()) {
                        suiteTestcase = filtered
                        echo '🧪 IMPORT using filtered suite/testcase map (invalid suites/testcases excluded)'
                    }
                }

                def suiteNames = toGroovyList(suiteTestcase.keySet())
                echo "🧪 IMPORT running suites: ${suiteNames.join(', ')}"

                def datetime = sh(script: "date +'%Y%m%d_%H%M%S'", returnStdout: true).trim()
                def label = suiteNames.size() == 1 ? suiteNames[0] : suiteNames.join('-')
                def suiteDir = "${label}_${datetime}"
                def zipName = "${label}_${datetime}.zip"
                env.SUITE_DIR = suiteDir
                env.ZIP_NAME = zipName

                def browser = toPlainString(params.browser)
                def environment = toPlainString(params.environment)

                // Build one Playwright invocation with exact discovered spec files (not whole suite dirs)
                // so a global -g cannot pick up same-titled tests from unrelated specs in other suites.
                def testPaths = []
                def grepTitles = []
                def anyAll = false
                def anyTitle = false
                suiteTestcase.each { suite, testcases ->
                    def suitePath = tryResolveSuitePath(suite as String)
                    if (!suitePath) {
                        echo "⚠️ IMPORT suite path not resolvable for '${suite}' — skipping"
                        return
                    }
                    def tcList = toGroovyList(testcases).findAll { it?.toString()?.trim() }.collect { it.toString().trim() }
                    if (tcList.contains('all')) {
                        anyAll = true
                        testPaths.add(suitePath)
                        echo "🧪 IMPORT suite '${suite}' mode=all → ${suitePath}"
                    } else if (tcList) {
                        anyTitle = true
                        def specs = resolveSpecFilesForSuiteTestcases(suitePath, tcList)
                        if (!specs) {
                            echo "⚠️ IMPORT suite '${suite}': no spec files resolved for titles ${tcList} — skipping"
                            return
                        }
                        specs.each { p ->
                            if (!testPaths.contains(p)) {
                                testPaths.add(p)
                            }
                        }
                        tcList.each { t ->
                            if (!grepTitles.contains(t)) {
                                grepTitles.add(t)
                            }
                        }
                        echo "🧪 IMPORT suite '${suite}' titles=${tcList} → specs=${specs}"
                    }
                }

                if (!testPaths) {
                    echo '⚠️ IMPORT: no resolvable suite/spec paths — skipping Playwright'
                    env.TEST_EXIT_CODE = '1'
                    try {
                        writeFinalValidationExecutionResult(1, true)
                    } catch (Exception e) {
                        echo "⚠️ IMPORT writeFinalValidationExecutionResult failed (continuing): ${e.message}"
                    }
                    return
                }

                def pathsArg = testPaths.collect { "'${it}'" }.join(' ')
                // Title-only runs: -g on exact files. If any suite is "all", omit -g so suite-dir paths are not filtered.
                def grepArg = ''
                if (anyTitle && !anyAll && grepTitles) {
                    def escaped = grepTitles.collect { escapePlaywrightGrepLiteral(it) }
                    def testcasePattern = escaped.join('|')
                    def safeGrep = testcasePattern.replace('"', '\\"')
                    grepArg = "-g \"${safeGrep}\""
                }

                echo "🧪 IMPORT: npx cross-env BROWSER=${browser} ENV=${environment} playwright test ${pathsArg} ${grepArg}"

                def logPid = startPeriodicLogging()
                def overallExitCode = 1
                try {
                    overallExitCode = timeout(time: 90, unit: 'MINUTES') {
                        sh(
                            script: """
                                set +e
                                timeout 5400 \\
                                    npx cross-env \\
                                    BROWSER="${browser}" \\
                                    ENV="${environment}" \\
                                    playwright test \\
                                    ${pathsArg} \\
                                    ${grepArg}
                                EXIT_CODE=\$?
                                exit \$EXIT_CODE
                            """,
                            returnStatus: true
                        )
                    }
                } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException e) {
                    echo "⚠️ IMPORT test execution timed out: ${e.message}"
                    overallExitCode = 1
                } catch (Exception e) {
                    echo "⚠️ IMPORT test execution error: ${e.message}"
                    overallExitCode = 1
                } finally {
                    stopPeriodicLogging(logPid)
                }

                echo "📟 IMPORT Playwright exit code: ${overallExitCode}"

                // TEMP DEBUG ONLY — after Playwright, before packaging (IMPORT)
                sh """
                    set +e
                    echo "===== IMPORT TEMP DIAGNOSTICS START ====="
                    echo "Executed command was:"
                    echo "npx cross-env BROWSER=${browser} ENV=${environment} playwright test ${pathsArg} ${grepArg}"
                    echo "Exit code: ${overallExitCode}"

                    pwd

                    echo "===== CUSTOMER PLAYWRIGHT CONFIG ====="
                    ls -la playwright.config.* 2>/dev/null || echo "(no playwright.config.* at workspace root)"
                    for f in playwright.config.ts playwright.config.js playwright.config.mjs; do
                      if [ -f "\$f" ]; then
                        echo "----- \$f -----"
                        sed -n '1,200p' "\$f"
                      fi
                    done
                    echo "----- reporter/outputFolder grep -----"
                    grep -n -E "reporter|outputFolder|outputFile|results|test-results|html" playwright.config.* 2>/dev/null || true

                    echo "===== ALL DIRECTORIES ====="
                    find . -maxdepth 5 -type d -print 2>/dev/null | sort

                    echo "===== ALL JSON FILES ====="
                    find . -maxdepth 7 -type f -name "*.json" -print 2>/dev/null | sort

                    echo "===== RESULT FILES ====="
                    find . -maxdepth 7 -type f \\( \\
                      -name "result.json" -o \\
                      -name "results.json" -o \\
                      -name "junit.xml" \\
                    \\) -print 2>/dev/null | sort

                    echo "===== PLAYWRIGHT ARTIFACTS ====="
                    find . -maxdepth 8 -type f \\( \\
                      -name "*.png" -o \\
                      -name "*.jpg" -o \\
                      -name "*.webm" -o \\
                      -name "*.mp4" -o \\
                      -name "trace.zip" \\
                    \\) -print 2>/dev/null | sort

                    echo "===== PLAYWRIGHT DIRECTORIES ====="
                    find . -maxdepth 5 -type d \\( \\
                      -name "results" -o \\
                      -name "test-results" -o \\
                      -name "playwright-report" -o \\
                      -name "reports" \\
                    \\) -print 2>/dev/null | sort

                    echo "===== IMPORT TEMP DIAGNOSTICS END ====="
                """

                suiteNames.each { suite ->
                    try {
                        createTestStatus(suite as String, overallExitCode as Integer)
                    } catch (Exception e) {
                        echo "⚠️ IMPORT createTestStatus failed for '${suite}' (continuing): ${e.message}"
                    }
                }

                echo "IMPORT test exit code: ${overallExitCode}"
                env.TEST_EXIT_CODE = "${overallExitCode}"

                try {
                    writeFinalValidationExecutionResult(overallExitCode as Integer, true)
                } catch (Exception e) {
                    echo "⚠️ IMPORT writeFinalValidationExecutionResult failed (continuing): ${e.message}"
                }

                try {
                    packageImportedPlaywrightResults(suiteDir, zipName)
                    addPendingUploadZip(zipName)
                } catch (Exception e) {
                    echo "⚠️ IMPORT packageImportedPlaywrightResults failed: ${e.message}"
                    writeExecutionResult('FAILED', 'Execute Tests', 'ZIP_CREATION_FAILED', "Zip packaging failed: ${e.message}")
                    try {
                        ensureMinimalMetadata()
                        sh """
                            set +e
                            echo "📦 IMPORT fallback packaging: ${zipName}"
                            mkdir -p "${suiteDir}/results"
                            cp "${env.METADATA_FILE}" "${suiteDir}/" 2>/dev/null || true
                            if [ -f "results/result.json" ] && [ -d "results" ]; then
                                rm -rf "${suiteDir}/results"
                                cp -a results "${suiteDir}/results"
                            elif [ -f "reports/default/results.json" ]; then
                                cp "reports/default/results.json" "${suiteDir}/results/result.json"
                                [ -d "reports/default/artifacts" ] && cp -a "reports/default/artifacts" "${suiteDir}/results/artifacts"
                                [ -d "test-results" ] && [ ! -d "${suiteDir}/results/artifacts" ] && cp -a "test-results" "${suiteDir}/results/artifacts"
                                [ -d "reports/default/html-report" ] && cp -a "reports/default/html-report" "${suiteDir}/results/html-report"
                                [ -d "playwright-report" ] && [ ! -d "${suiteDir}/results/html-report" ] && cp -a "playwright-report" "${suiteDir}/results/html-report"
                                [ -f "reports/default/junit.xml" ] && cp "reports/default/junit.xml" "${suiteDir}/results/junit.xml"
                            fi
                            zip -r -q -6 "${zipName}" "${suiteDir}"
                            rm -rf "${suiteDir}"
                            ls -lh "${zipName}" 2>/dev/null || true
                        """
                        if (fileExists(zipName)) {
                            addPendingUploadZip(zipName)
                            echo "✅ IMPORT fallback ZIP ready: ${zipName}"
                        } else {
                            echo "❌ IMPORT fallback ZIP was not created"
                        }
                    } catch (Exception e2) {
                        echo "⚠️ IMPORT fallback packaging also failed: ${e2.message}"
                    }
                }

                if (overallExitCode != 0) {
                    echo '⚠️ IMPORT tests failed - marking build as UNSTABLE (artifacts preserved for S3 upload)'
                    currentBuild.result = 'UNSTABLE'
                } else if (env.PARTIAL_TESTCASES == 'true' || env.HAS_INVALID_SUITES == 'true') {
                    echo '⚠️ IMPORT PARTIAL_FAILED — single execution ZIP uploaded (validation details in metadata.json)'
                } else {
                    echo '✅ IMPORT tests passed'
                }
            }

            // Decrypt a single AES-256-CBC (pbkdf2) Base64 value using the Jenkins-held encryption key.
            // Key comes only from the 'aws-encryption-key' Secret Text credential, never a parameter.
            // Writes ciphertext to a temp file, decrypts, returns plaintext, and always removes temp files.
            def decryptValue(String encryptedValue, String stage = 'Checkout') {
                if (!encryptedValue?.trim()) {
                    def code = (stage == 'Upload to S3') ? 'UPLOAD_FAILED' : 'INVALID_CLIENT_PAT'
                    def msg = (stage == 'Upload to S3')
                        ? 'Invalid AWS credentials. Please verify the encrypted AWS access keys.'
                        : 'Invalid GitHub Personal Access Token. Please verify the encrypted client_pat.'
                    writeExecutionResult('FAILED', stage, code, msg)
                    error(msg)
                }

                def encFile = ".dec-in-${UUID.randomUUID().toString()}"
                def outFile = ".dec-out-${UUID.randomUUID().toString()}"
                writeFile(file: encFile, text: encryptedValue.trim())

                withCredentials([string(credentialsId: 'aws-encryption-key', variable: 'ENCRYPTION_KEY')]) {
                    try {
                        def status = withEnv(["DEC_IN=${encFile}", "DEC_OUT=${outFile}"]) {
                            sh(
                                label: 'Decrypt value',
                                returnStatus: true,
                                script: '''
                                    set +x
                                    openssl enc -d -aes-256-cbc -pbkdf2 -a -A -in "$DEC_IN" -out "$DEC_OUT" -pass env:ENCRYPTION_KEY
                                '''
                            )
                        }
                        if (status != 0) {
                            def code = (stage == 'Upload to S3') ? 'UPLOAD_FAILED' : 'INVALID_CLIENT_PAT'
                            def msg = (stage == 'Upload to S3')
                                ? 'Invalid AWS credentials. Please verify the encrypted AWS access keys.'
                                : 'Invalid GitHub Personal Access Token. Please verify the encrypted client_pat.'
                            writeExecutionResult('FAILED', stage, code, msg)
                            error(msg)
                        }

                        def plaintext = readFile(outFile).trim()
                        if (!plaintext) {
                            def code = (stage == 'Upload to S3') ? 'UPLOAD_FAILED' : 'INVALID_CLIENT_PAT'
                            def msg = (stage == 'Upload to S3')
                                ? 'Invalid AWS credentials. Please verify the encrypted AWS access keys.'
                                : 'Invalid GitHub Personal Access Token. Please verify the encrypted client_pat.'
                            writeExecutionResult('FAILED', stage, code, msg)
                            error(msg)
                        }
                        return plaintext
                    } finally {
                        sh(label: 'Cleanup temp files', script: "rm -f '${encFile}' '${outFile}'")
                    }
                }
            }

            // Docker run args: Jenkins host UID:GID (avoid root-owned Playwright artifacts)
            def dockerAgentRunArgs() {
                def uid = sh(script: 'id -u', returnStdout: true).trim()
