            def checkoutClientTestsRepository() {
                def clientUrl = params.client_repo_url?.trim()
                if (!clientUrl) {
                    writeExecutionResult('FAILED', 'Checkout', 'INVALID_REPOSITORY_URL', 'Unable to access the client repository. Verify the repository URL.')
                    error('Unable to access the client repository. Verify the repository URL.')
                }
                if (!params.client_username?.trim()) {
                    writeExecutionResult('FAILED', 'Checkout', 'INVALID_REPOSITORY_CREDENTIALS', 'Invalid GitHub username or Personal Access Token.')
                    error('Invalid GitHub username or Personal Access Token.')
                }
                String gitPassword = decryptValue(params.client_pat)
                if (!gitPassword) {
                    writeExecutionResult('FAILED', 'Checkout', 'INVALID_CLIENT_PAT', 'Invalid GitHub Personal Access Token. Please verify the encrypted client_pat.')
                    error('Invalid GitHub Personal Access Token. Please verify the encrypted client_pat.')
                }

                def clientBranch = params.client_branch?.trim()
                if (!clientBranch) {
                    writeExecutionResult('FAILED', 'Checkout', 'BRANCH_NOT_FOUND', 'Specified branch was not found in the client repository.')
                    error('Specified branch was not found in the client repository.')
                }
                def clientTestsDir = 'client-tests'

                sh "rm -rf ${clientTestsDir}"

                def repoHostPath = clientUrl.replaceFirst('(?i)^https://', '')
                def safeBranch = clientBranch.replace("'", "'\\''")
                def safeHostPath = repoHostPath.replace("'", "'\\''")
                def authUser = repoHostPath.toLowerCase().startsWith('github.com/')
                    ? 'x-access-token'
                    : params.client_username.trim().replace("'", "'\\''")

                withEnv(["CLIENT_GIT_PASSWORD=${gitPassword}"]) {
                    // Remove any leftover root-owned clone_out.txt before capturing output
                    sh '''
                        set +e
                        if command -v docker >/dev/null 2>&1; then
                            docker run --rm \
                                -v "$(pwd):/ws" \
                                -w /ws \
                                --user root \
                                alpine:3.19 \
                                sh -c 'rm -f /ws/clone_out.txt' \
                                2>/dev/null || true
                        fi
                        rm -f clone_out.txt 2>/dev/null || true
                    '''

                    def cloneOutput = sh(
                        label: 'Clone client repository',
                        returnStdout: true,
                        script: """
                            set +e
                            set +x
                            git clone --depth 1 --no-tags --branch '${safeBranch}' \\
                                "https://${authUser}:\${CLIENT_GIT_PASSWORD}@${safeHostPath}" client-tests 2>&1
                            printf '\\n__CLONE_EXIT__=%s\\n' "\$?"
                        """
                    ).trim()

                    def cloneStatus = 1
                    def cloneLines = cloneOutput.readLines()
                    def exitLine = cloneLines.reverse().find { it.startsWith('__CLONE_EXIT__=') }
                    if (exitLine) {
                        cloneStatus = exitLine.substring('__CLONE_EXIT__='.length()).trim() as Integer
                    }
                    def cloneLog = cloneLines.findAll { !it.startsWith('__CLONE_EXIT__=') }.join('\n').trim()
                    // Jenkins-owned file (never root) for existing error parsers
                    writeFile(file: 'clone_out.txt', text: cloneLog ? (cloneLog + '\n') : '')
                    sh 'chmod a+rw clone_out.txt 2>/dev/null || true'

                    try {
                        if (cloneStatus != 0) {
                            def parsedLog = fileExists('clone_out.txt') ? readFile('clone_out.txt') : ''
                            def logLower = parsedLog.toLowerCase()
                            def code = 'CLIENT_REPO_CLONE_FAILED'
                            def msg = 'Failed to clone the client repository.'
                            if (logLower.contains('remote branch') && logLower.contains('not found')) {
                                code = 'BRANCH_NOT_FOUND'
                                msg = 'Specified branch was not found in the client repository.'
                            } else if (logLower.contains('authentication failed') || logLower.contains('invalid username') || logLower.contains('403') || logLower.contains('could not read username')) {
                                code = 'INVALID_REPOSITORY_CREDENTIALS'
                                msg = 'Invalid GitHub username or Personal Access Token.'
                            } else if (logLower.contains('repository not found') || logLower.contains('404')) {
                                code = 'INVALID_REPOSITORY_URL'
                                msg = 'Unable to access the client repository. Verify the repository URL.'
                            }
                            writeExecutionResult('FAILED', 'Checkout', code, msg)
                            error(msg)
                        }
                    } finally {
                        sh '''
                            set +e
                            if command -v docker >/dev/null 2>&1; then
                                docker run --rm \
                                    -v "$(pwd):/ws" \
                                    -w /ws \
                                    --user root \
                                    alpine:3.19 \
                                    sh -c 'rm -f /ws/clone_out.txt' \
                                    2>/dev/null || true
                            fi
                            rm -f clone_out.txt 2>/dev/null || true
                        '''
                    }
                }

                echo "✅ Client repository checked out: ${clientUrl} @ ${clientBranch}"
            }

