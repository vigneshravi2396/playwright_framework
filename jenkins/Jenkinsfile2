            def resolveSuitePath(String suite) {
                def map = getSuitePathMap()
                if (!map.containsKey(suite)) {
                    writeExecutionResult('FAILED', 'Validate Suite', 'SUITE_NOT_FOUND', "Suite '${suite}' not found under tests/ (searched recursively)")
                    error("Suite '${suite}' not found under tests/ (searched recursively)")
                }
                def path = map[suite]
                if (path instanceof Collection) {
                    def pathList = toGroovyList(path)
                    if (pathList.size() > 1) {
                        writeExecutionResult('FAILED', 'Validate Suite', 'SUITE_NOT_FOUND', "Ambiguous suite '${suite}': found at ${pathList.join(', ')}")
                        error("Ambiguous suite '${suite}': found at ${pathList.join(', ')}")
                    }
                    return pathList[0] as String
                }
                return path as String
            }

            // Non-failing suite path lookup for collect-all validation (returns null if missing/ambiguous/absent on disk)
            def tryResolveSuitePath(String suite) {
                def map = getSuitePathMap()
                if (!map.containsKey(suite)) {
                    return null
                }
                def path = map[suite]
                if (path instanceof Collection) {
                    def pathList = toGroovyList(path)
                    if (pathList.size() != 1) {
                        echo "❌ Ambiguous suite '${suite}': found at ${pathList.join(', ')}"
                        return null
                    }
                    path = pathList[0]
                }
                def suiteExists = sh(
                    script: "test -d '${path}'",
                    returnStatus: true
                ) == 0
                return suiteExists ? (path as String) : null
            }

            // Collect valid/failed suites without error() — filter to valid only; Case 4 deferred
            def validateSuiteTestcase(Map suiteTestcase) {
                // Reset pending upload list for this run
                writeJSON(file: '.pipeline-upload-zips.json', json: [])
                env.PENDING_UPLOAD_ZIPS_FILE = '.pipeline-upload-zips.json'

                def validSuites = []
                def failedSuites = []
                def filtered = [:]

                suiteTestcase.each { suite, testcases ->
                    echo "Validating suite: ${suite}"
                    if (!(testcases instanceof List) || testcases.isEmpty()) {
                        failedSuites.add(suite)
                        echo "❌ Suite '${suite}' has empty/invalid testcase list"
                        return
                    }
                    def suiteDir = tryResolveSuitePath(suite)
                    if (!suiteDir) {
                        failedSuites.add(suite)
                        echo "❌ Suite '${suite}' not found under tests/"
                        return
                    }
                    validSuites.add(suite)
                    filtered[suite] = toGroovyList(testcases)
                    echo "✅ Suite '${suite}' validated at ${suiteDir}"
                }

                writeJSON(file: '.pipeline-valid-suites.json', json: validSuites)
                writeJSON(file: '.pipeline-failed-suites.json', json: failedSuites)
                writeJSON(file: '.pipeline-filtered-suite-testcase.json', json: filtered)
                env.FILTERED_SUITE_TESTCASE_FILE = '.pipeline-filtered-suite-testcase.json'
                env.HAS_INVALID_SUITES = failedSuites ? 'true' : 'false'

                echo "📊 Suite validation: valid=${validSuites.size()}, failed=${failedSuites.size()}"
                // Do NOT call error() — continue so all suites/testcases are collected
            }

            // Validate mixed testcase entries: .spec.ts filenames (file search) + titles (playwright --list)
            def validateTestcaseFiles(Map suiteTestcase) {
                def filteredFile = env.FILTERED_SUITE_TESTCASE_FILE ?: '.pipeline-filtered-suite-testcase.json'
                def input = suiteTestcase
                if (fileExists(filteredFile)) {
                    def fromSuiteValidation = readJSON(file: filteredFile)
                    if (fromSuiteValidation instanceof Map) {
                        input = fromSuiteValidation
                    }
                }

                def filtered = [:]
                def executed = []
                def missing = []
                def missingBySuite = [:]

                input.each { suite, testcases ->
                    def suiteDir = tryResolveSuitePath(suite as String)
                    if (!suiteDir) {
                        echo "⚠️ Skipping testcase validation for suite '${suite}' — path not resolvable"
                        return
                    }
                    echo "Validating testcases for suite: ${suite} (${suiteDir})"

                    def tcList = toGroovyList(testcases)
                    if (tcList.contains('all')) {
                        filtered[suite] = tcList
                        echo "Suite '${suite}' uses 'all' — skipping per-testcase validation"
                        return
                    }

                    // Lazy --list only when at least one title entry is present
                    def suiteTitles = null
                    def existing = []
                    def suiteMissing = []

                    tcList.each { name ->
                        if (!name?.trim()) {
                            return
                        }
                        name = name.trim()

                        if (name.endsWith('.spec.ts')) {
                            // Filename mode — recursive find under suite; do NOT use --list
                            def foundPath = findSpecFileInSuite(suiteDir, name)
                            if (foundPath) {
                                existing.add(name)
                                executed.add(name)
                                echo "✅ Spec file found: ${foundPath}"
                            } else {
                                suiteMissing.add(name)
                                missing.add(name)
                                echo "❌ Spec file not found under ${suiteDir}: ${name}"
                            }
                        } else {
                            // Title mode — compare against playwright --list
                            if (suiteTitles == null) {
                                suiteTitles = listPlaywrightTestcases(suiteDir)
                                echo "📋 Playwright --list discovered ${suiteTitles.size()} testcase(s) under ${suiteDir}"
                                suiteTitles.each { t -> echo "   • ${t}" }
                            }
                            if (suiteTitles.contains(name)) {
                                existing.add(name)
                                executed.add(name)
                                echo "✅ Title found: ${name}"
                            } else {
                                suiteMissing.add(name)
                                missing.add(name)
                                echo "❌ Title not found in suite '${suite}': ${name}"
                            }
                        }
                    }
                    if (suiteMissing) {
                        missingBySuite[suite] = suiteMissing
                    }
                    if (existing) {
                        filtered[suite] = existing
                    }
                }

                writeJSON(file: '.pipeline-executed-testcases.json', json: executed)
                writeJSON(file: '.pipeline-missing-testcases.json', json: missing)
                writeJSON(file: '.pipeline-missing-by-suite.json', json: missingBySuite)
                writeJSON(file: '.pipeline-filtered-suite-testcase.json', json: filtered)
                env.EXECUTED_TESTCASES_FILE = '.pipeline-executed-testcases.json'
                env.MISSING_TESTCASES_FILE = '.pipeline-missing-testcases.json'
                env.FILTERED_SUITE_TESTCASE_FILE = '.pipeline-filtered-suite-testcase.json'

                def failedSuites = readPipelineJsonList('.pipeline-failed-suites.json')
                def hasExecutable = filtered && !filtered.isEmpty()
                def hasInvalid = (failedSuites && !failedSuites.isEmpty()) || (missing && !missing.isEmpty())

                if (!hasExecutable) {
                    env.SKIP_PLAYWRIGHT = 'true'
                    env.PARTIAL_TESTCASES = 'false'
                    echo '❌ No valid suites/testcases remain — Playwright will be skipped'
                } else if (hasInvalid) {
                    env.SKIP_PLAYWRIGHT = 'false'
                    env.PARTIAL_TESTCASES = 'true'
                    echo "⚠️ Partial validation — will execute valid items only (suites failed=${failedSuites.size()}, missing=${missing.size()})"
                } else {
                    env.SKIP_PLAYWRIGHT = 'false'
                    env.PARTIAL_TESTCASES = 'false'
                    echo '✅ All requested suites/testcases validated'
                }
            }

            // Recursive find of a .spec.ts basename under suiteDir (returns first match path or null)
            def findSpecFileInSuite(String suiteDir, String fileName) {
                def base = fileName.toString().trim()
                if (base.contains('/')) {
                    base = base.tokenize('/').last()
                }
                def safeBase = base.replace("'", "'\\''")
                def safeDir = suiteDir.toString().replace("'", "'\\''")
                def output = sh(
                    script: "find '${safeDir}' -type f -name '${safeBase}' 2>/dev/null | head -n 1",
                    returnStdout: true
                ).trim()
                return output ? output : null
            }

            // Escape literal testcase titles for Playwright --grep (JS RegExp)
            def escapePlaywrightGrepLiteral(String input) {
                def s = (input ?: '').toString()
                ['\\', '.', '^', '+', '*', '?', '(', ')', '[', ']', '{', '}', '|', '$'].each { c ->
                    s = s.replace(c, '\\' + c)
                }
                return s
            }

            // IMPORT only: map testcase titles → spec file paths via playwright --list (no test execution)
            def resolveSpecFilesForSuiteTestcases(String suiteDir, List testcaseTitles) {
                def wanted = toGroovyList(testcaseTitles).findAll { it?.toString()?.trim() }.collect { it.toString().trim() }
                if (!wanted || !suiteDir) {
                    return []
                }

                def pwBin = fileExists('node_modules/.bin/playwright') ?
                    './node_modules/.bin/playwright' : 'npx playwright'
                def browser = toPlainString(params.browser)
                def environment = toPlainString(params.environment)

                echo "🔎 IMPORT resolving specs under ${suiteDir} for titles: ${wanted}"
                def output = withEnv([
                    "PLAYWRIGHT_BROWSERS_PATH=${env.PLAYWRIGHT_BROWSERS_PATH ?: '/ms-playwright'}",
                    "BROWSER=${browser}",
                    "ENV=${environment}"
                ]) {
                    sh(
                        label: 'Playwright --list (IMPORT title→file)',
                        returnStdout: true,
                        script: """
                            set +e
                            npx cross-env \\
                                BROWSER="${browser}" \\
                                ENV="${environment}" \\
                                ${pwBin} test '${suiteDir}' --list 2>&1
                        """
                    ).trim()
                }

                def titleToFiles = [:]
                if (output) {
                    output.split('\n').each { line ->
                        def trimmed = line?.trim()
                        if (!trimmed || !trimmed.contains('›')) {
                            return
                        }
                        if (trimmed.startsWith('Listing') || trimmed.startsWith('Total:')) {
                            return
                        }
                        def parts = trimmed.split('›')
                        if (parts.length < 3) {
                            return
                        }
                        def loc = parts[1]?.trim()
                        if (!loc) {
                            return
                        }
                        def filePath = loc.replaceAll(/:\d+:\d+\s*$/, '').trim()
                        def leaf = parts[parts.length - 1]?.trim()
                        if (!filePath || !leaf) {
                            return
                        }
                        if (!titleToFiles.containsKey(leaf)) {
                            titleToFiles[leaf] = []
                        }
                        if (!titleToFiles[leaf].contains(filePath)) {
                            titleToFiles[leaf].add(filePath)
                        }
                    }
                }

                def resolved = []
                wanted.each { title ->
                    def files = titleToFiles[title]
                    if (!files) {
                        echo "⚠️ IMPORT: title '${title}' not found in --list under ${suiteDir}"
                        return
                    }
                    files.each { f ->
                        if (!resolved.contains(f)) {
                            resolved.add(f)
                        }
                    }
                }
                echo "🔎 IMPORT resolved ${resolved.size()} spec file(s) under ${suiteDir}: ${resolved}"
                return resolved
            }

            // Run `playwright test <suiteDir> --list` and return List of testcase titles (leaf names).
            def listPlaywrightTestcases(String suiteDir) {
                def pwBin = fileExists('node_modules/.bin/playwright') ?
                    './node_modules/.bin/playwright' : 'npx playwright'
                // Plain strings required — params.* wrappers in withEnv alone may not reach the Playwright process
                def browser = toPlainString(params.browser)
                def environment = toPlainString(params.environment)

                echo "📋 Listing Playwright tests: BROWSER=${browser} ENV=${environment} ${pwBin} test ${suiteDir} --list"
                def output = withEnv([
                    "PLAYWRIGHT_BROWSERS_PATH=${env.PLAYWRIGHT_BROWSERS_PATH ?: '/ms-playwright'}",
                    "BROWSER=${browser}",
                    "ENV=${environment}"
                ]) {
                    sh(
                        label: 'Playwright --list',
                        returnStdout: true,
                        script: """
                            set +e
                            npx cross-env \\
                                BROWSER="${browser}" \\
                                ENV="${environment}" \\
                                ${pwBin} test '${suiteDir}' --list 2>&1
                        """
                    ).trim()
                }

                def titles = []
                if (!output) {
                    echo "⚠️ playwright --list returned empty output for ${suiteDir}"
                    return titles
                }

                // Lines look like: [chromium] › path/to/file.spec.ts:10:5 › Parent › Sauce 3.1 description
                output.split('\n').each { line ->
                    def trimmed = line?.trim()
                    if (!trimmed || !trimmed.contains('›')) {
                        return
                    }
                    if (trimmed.startsWith('Listing') || trimmed.startsWith('Total:')) {
                        return
                    }
                    def parts = trimmed.split('›')
                    if (parts.length < 3) {
                        return
                    }
                    def leaf = parts[parts.length - 1]?.trim()
                    if (leaf && !titles.contains(leaf)) {
                        titles.add(leaf)
                    }
                }

                echo "📋 Parsed ${titles.size()} unique testcase title(s) from --list"
                return titles
            }

            // List every *.spec.ts under a suite (used only for "all" mode file-path execution)
            def listSuiteSpecFiles(String suiteDir) {
                def output = sh(
                    script: "find '${suiteDir}' -type f -name '*.spec.ts' 2>/dev/null | sort",
                    returnStdout: true
                ).trim()
                if (!output) {
                    return []
                }
                return toGroovyList(output.split('\n')).findAll { it?.trim() }
            }

            // Build execution plan for a suite:
            // - "all" → all .spec.ts paths
            // - .spec.ts names → resolved file paths (direct run, no grep)
            // - titles → suiteDir + --grep "T1|T2"
            // - mixed → both filePaths and titleGrep (runSuiteTestcases runs both)
            def buildPlaywrightTestPaths(String suite, List testcases) {
                def suiteDir = resolveSuitePath(suite)
                if (testcases.contains('all')) {
                    def allSpecs = listSuiteSpecFiles(suiteDir)
                    if (!allSpecs) {
                        writeExecutionResult('FAILED', 'Execute Tests', 'TESTCASE_NOT_FOUND', "No .spec.ts files found under ${suiteDir}")
                        error("No .spec.ts files found under ${suiteDir}")
                    }
                    return [suiteDir: suiteDir, filePaths: allSpecs, titleGrep: '', skip: false]
                }

                def names = toGroovyList(testcases).findAll { it?.trim() }.collect { it.trim() }
                if (!names) {
                    echo "⏭️ Suite '${suite}' — no testcases to run"
                    return [suiteDir: suiteDir, filePaths: [], titleGrep: '', skip: true]
                }

                def filePaths = []
                def titles = []
                names.each { name ->
                    if (name.endsWith('.spec.ts')) {
                        def found = findSpecFileInSuite(suiteDir, name)
                        if (found) {
                            filePaths.add(found)
                            echo "✅ Execute file: ${found}"
                        } else {
                            echo "⚠️ Spec missing at execute time (skipped): ${name}"
                        }
                    } else {
                        titles.add(name)
                        echo "✅ Execute title: ${name}"
                    }
                }

                def titleGrep = titles ? titles.join('|') : ''
                if (!filePaths && !titleGrep) {
                    return [suiteDir: suiteDir, filePaths: [], titleGrep: '', skip: true]
                }

                echo "🔎 Plan suite='${suite}' files=${filePaths.size()} titles=${titles.size()} grep=\"${titleGrep}\""
                return [suiteDir: suiteDir, filePaths: filePaths, titleGrep: titleGrep, skip: false]
            }

