            // IMPORT: accept backend suite_testcase as-is (no playwright --list / title discovery)
            def prepareImportedExecutionPlanFromBackend() {
                def filteredFile = env.FILTERED_SUITE_TESTCASE_FILE ?: '.pipeline-filtered-suite-testcase.json'
                def filtered = readPipelineJsonMap(filteredFile)
                def executed = []
