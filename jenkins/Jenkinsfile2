                def testExitCode = env.TEST_EXIT_CODE ?: 'N/A'
                def zipFile = env.ZIP_NAME ?: env.FINAL_ZIP_NAME ?: 'N/A'
                def duration = currentBuild.durationString.replace(' and counting', '')

                def testStatus = 'N/A'
                if (testExitCode != 'N/A') {
                    testStatus = (testExitCode == '0') ? '✅ PASSED' : '❌ FAILED'
                }

                def s3Location = 'N/A'
                if (zipFile != 'N/A') {
